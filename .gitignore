# 构建产物
target/
output/

# wgpu-native 厂商包：运行时只动态加载 DLL，静态库/导入库不入库（各 37MB/0.2MB）
wgpu-win/lib/*.a
wgpu-win/lib/*.dll.a

# 临时文件
*.tmp
.mimosa/
nes-media/avi_probe_out/

# S15：视频演示资产不入库（用户机器实测 AMV，十几 MB 级；video_demo /
