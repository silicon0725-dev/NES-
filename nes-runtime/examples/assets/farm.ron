// S10-0 第二项目 **v2**：Seed & Harvest —— 用 S10-1 的 timer + hit 重构。
// 消除 v1 的 6 个平行 g0..g5 计时局部 → per-entity NodeData.timer。
// "点击地块种植"替代数字键（hit 命中检测）。
//
// 玩法：鼠标点击地块种植（花 5 金）；苗生长 ~1 秒（timer 倒数）；
// 熟自动收获（+15 金）。50 金 WIN。
Scene(
    version: 1,
    resources: [
        Res(id: 1, path: "Textures/heart.bmp", kind: "Texture"),
    ],
    root: Node(
        name: "main",
        kind: "Node",
        children: [
            Node(name: "cam", kind: "Camera2D", local: (x: 192.0, y: 108.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), children: [],),
            Node(name: "plots", kind: "Node", children: [
                Node(name: "p0", kind: "Sprite2D", local: (x: 100.0, y: 80.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(1), "z_index": 0, "visible": true, }, children: [],),
                Node(name: "p1", kind: "Sprite2D", local: (x: 192.0, y: 80.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(1), "z_index": 0, "visible": true, }, children: [],),
                Node(name: "p2", kind: "Sprite2D", local: (x: 284.0, y: 80.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(1), "z_index": 0, "visible": true, }, children: [],),
                Node(name: "p3", kind: "Sprite2D", local: (x: 100.0, y: 160.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(1), "z_index": 0, "visible": true, }, children: [],),
                Node(name: "p4", kind: "Sprite2D", local: (x: 192.0, y: 160.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(1), "z_index": 0, "visible": true, }, children: [],),
                Node(name: "p5", kind: "Sprite2D", local: (x: 284.0, y: 160.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(1), "z_index": 0, "visible": true, }, children: [],),
            ],),
            Node(name: "hud", kind: "Label", local: (x: 8.0, y: 4.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "text": "GOLD:20", }, children: [],),
            Node(name: "game", kind: "Script", props: { "source": "init { gold = 20; day = 1; t = 0; cd = 0; plots = children(node(\"plots\")) }\non \"tick\" { t = t + 1; if t >= 300 { t = 0; day = day + 1 }; if cd > 0 { cd = cd - 1 }; if cd <= 0 { if button(\"left\") { h = hit(mouse_x(), mouse_y()); if h != false { if node(h).z_index == 0 { if gold >= 5 { gold = gold - 5; node(h).timer = 60; node(h).z_index = 1; node(h).texture_flip_h = true; cd = 20 } } } } }; for_each(plots) { if it.z_index == 1 { if it.timer == 0 { it.z_index = 2 } }; if it.z_index == 2 { gold = gold + 15; it.z_index = 0; it.texture_flip_h = false } }; if gold >= 50 { hud.text = \"WIN GOLD:\" + num_to_str(gold); emit \"win\" 0 } else { hud.text = \"GOLD:\" + num_to_str(gold) + \" DAY:\" + num_to_str(day) + \" | CLICK=plant\" } }" }, children: [],),
        ],
    ),
)
