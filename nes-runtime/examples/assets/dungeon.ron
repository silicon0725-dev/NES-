// S8.2b 验收：Mini Dungeon **v3** —— 实体句柄 + 集合 + 输入读面重构版。
//
// 玩法升级：方向键移动；**鼠标瞄准**（b-3 读面 mouse_x/mouse_y 驱动
// marker）；Space 发射**制导弹**（5 发并发池，各自追 marker、到点/
// 命中回收）；击杀 8 开门进门 WIN；被追满 3 次 LOSE；每 3 杀掉心
// 回 1 点。
//
// v3 架构主张（对照 v2 指标见 S8.2b 验收文档）：
// - 弹丸 = 哑实体 + 各自自治脚本（追 marker / 到点停机坪 / 出界回收）
//   —— 弹道状态住在**弹丸几何**，管理器零 per-弹平行变量；
// - gun 只持 `bullets` 句柄数组 + 轮转下标 bi；
// - referee 碰撞 = **嵌套 for_each**（外层弹存局部句柄 bh，内层敌用
//   it —— 内层遮蔽的正规解法）；v2 的 d1/d2/d3 + pd×3 + 重生×3
//   展开全部坍缩为两个循环体；
// - 敌人保持各自 chase 脚本（实体自治行为的正面形态）。
Scene(
    version: 1,
    resources: [
        Res(id: 1, path: "Textures/player.bmp", kind: "Texture"),
        Res(id: 2, path: "Textures/enemy.bmp", kind: "Texture"),
        Res(id: 3, path: "Textures/bullet.bmp", kind: "Texture"),
        Res(id: 4, path: "Textures/heart.bmp", kind: "Texture"),
        Res(id: 5, path: "Textures/door.bmp", kind: "Texture"),
    ],
    root: Node(
        name: "main",
        kind: "Node",
        children: [
            Node(name: "cam", kind: "Camera2D", local: (x: 192.0, y: 108.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), children: [],),
            Node(name: "player", kind: "Sprite2D", local: (x: 40.0, y: 108.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(1), }, children: [],),
            // 瞄准标记（隐形）：鼠标位；制导弹的靶。
            Node(name: "marker", kind: "Node2D", local: (x: 200.0, y: 108.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), children: [],),
            // 弹丸池：5 个哑实体 + 各自自治飞行脚本（同源）。
            Node(name: "bullets", kind: "Node", children: [
                Node(name: "b0", kind: "Sprite2D", local: (x: -100.0, y: -100.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(3), }, children: [
                    Node(name: "fly", kind: "Script", props: { "source": "every { if this.pos.x > -50.0 { this.pos = xy(this.pos.x + (marker.pos.x - this.pos.x) * 0.22, this.pos.y + (marker.pos.y - this.pos.y) * 0.22); mx = marker.pos.x - this.pos.x; my = marker.pos.y - this.pos.y; if mx * mx + my * my < 25.0 { this.pos = xy(-100.0, -100.0) } } }" }, children: [],),
                ],),
                Node(name: "b1", kind: "Sprite2D", local: (x: -100.0, y: -100.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(3), }, children: [
                    Node(name: "fly", kind: "Script", props: { "source": "every { if this.pos.x > -50.0 { this.pos = xy(this.pos.x + (marker.pos.x - this.pos.x) * 0.22, this.pos.y + (marker.pos.y - this.pos.y) * 0.22); mx = marker.pos.x - this.pos.x; my = marker.pos.y - this.pos.y; if mx * mx + my * my < 25.0 { this.pos = xy(-100.0, -100.0) } } }" }, children: [],),
                ],),
                Node(name: "b2", kind: "Sprite2D", local: (x: -100.0, y: -100.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(3), }, children: [
                    Node(name: "fly", kind: "Script", props: { "source": "every { if this.pos.x > -50.0 { this.pos = xy(this.pos.x + (marker.pos.x - this.pos.x) * 0.22, this.pos.y + (marker.pos.y - this.pos.y) * 0.22); mx = marker.pos.x - this.pos.x; my = marker.pos.y - this.pos.y; if mx * mx + my * my < 25.0 { this.pos = xy(-100.0, -100.0) } } }" }, children: [],),
                ],),
                Node(name: "b3", kind: "Sprite2D", local: (x: -100.0, y: -100.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(3), }, children: [
                    Node(name: "fly", kind: "Script", props: { "source": "every { if this.pos.x > -50.0 { this.pos = xy(this.pos.x + (marker.pos.x - this.pos.x) * 0.22, this.pos.y + (marker.pos.y - this.pos.y) * 0.22); mx = marker.pos.x - this.pos.x; my = marker.pos.y - this.pos.y; if mx * mx + my * my < 25.0 { this.pos = xy(-100.0, -100.0) } } }" }, children: [],),
                ],),
                Node(name: "b4", kind: "Sprite2D", local: (x: -100.0, y: -100.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(3), }, children: [
                    Node(name: "fly", kind: "Script", props: { "source": "every { if this.pos.x > -50.0 { this.pos = xy(this.pos.x + (marker.pos.x - this.pos.x) * 0.22, this.pos.y + (marker.pos.y - this.pos.y) * 0.22); mx = marker.pos.x - this.pos.x; my = marker.pos.y - this.pos.y; if mx * mx + my * my < 25.0 { this.pos = xy(-100.0, -100.0) } } }" }, children: [],),
                ],),
            ],),
            // 敌人组：3 台自治追踪者（children 序 = referee 的结构序）。
            Node(name: "enemies", kind: "Node", children: [
                Node(name: "e1", kind: "Sprite2D", local: (x: 360.0, y: 20.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(2), }, children: [],),
                Node(name: "e2", kind: "Sprite2D", local: (x: 360.0, y: 196.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(2), }, children: [],),
                Node(name: "e3", kind: "Sprite2D", local: (x: 20.0, y: 20.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(2), }, children: [],),
            ],),
            // 自治追踪脚本（顶层具名 —— this 是脚本节点自身，实体经名查；
            // 句柄/集合用在 gun 与 referee 的规模化路径上）。
            Node(name: "e1_brain", kind: "Script", props: { "source": "on \"tick\" { dx = player.pos.x - e1.pos.x; dy = player.pos.y - e1.pos.y; ax = dx; if ax < 0.0 { ax = 0.0 - dx }; ay = dy; if ay < 0.0 { ay = 0.0 - dy }; if ax > ay { if dx > 0.0 { e1.pos = xy(e1.pos.x + 1.4, e1.pos.y) } else { e1.pos = xy(e1.pos.x - 1.4, e1.pos.y) } } else { if dy > 0.0 { e1.pos = xy(e1.pos.x, e1.pos.y + 1.4) } else { e1.pos = xy(e1.pos.x, e1.pos.y - 1.4) } } }" }, children: [],),
            Node(name: "e2_brain", kind: "Script", props: { "source": "init { k = 0.030 }
on \"tick\" { dx = player.pos.x - e2.pos.x; dy = player.pos.y - e2.pos.y; e2.pos = xy(e2.pos.x + dx * k, e2.pos.y + dy * k) }" }, children: [],),
            Node(name: "e3_brain", kind: "Script", props: { "source": "on \"tick\" { dx = player.pos.x - e3.pos.x; dy = player.pos.y - e3.pos.y; ax = dx; if ax < 0.0 { ax = 0.0 - dx }; ay = dy; if ay < 0.0 { ay = 0.0 - dy }; if ax > ay { if dx > 0.0 { e3.pos = xy(e3.pos.x + 2.2, e3.pos.y) } else { e3.pos = xy(e3.pos.x - 2.2, e3.pos.y) } } else { if dy > 0.0 { e3.pos = xy(e3.pos.x, e3.pos.y + 2.2) } else { e3.pos = xy(e3.pos.x, e3.pos.y - 2.2) } } }" }, children: [],),
            Node(name: "heart", kind: "Sprite2D", local: (x: -100.0, y: -100.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(4), }, children: [],),
            Node(name: "door", kind: "Sprite2D", local: (x: 352.0, y: 108.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "texture": Resource(5), "visible": false, }, children: [],),
            Node(name: "hud", kind: "Label", local: (x: 8.0, y: 4.0, rot: 0.0, sx: 1.0, sy: 1.0, skew: 0.0), props: { "text": "HP 3  SCORE 0", }, children: [],),
            // 玩家侧：移动 + 鼠标 marker + 轮转发射（弹道零管理器字段）。
            Node(
                name: "player_brain",
                kind: "Script",
                props: { "source": "init { x = 40.0; y = 108.0; cd = 0; bi = 0; bullets = children(node(\"bullets\")) }\non \"tick\" { if key(\"ArrowLeft\") { x = x - 2.5 }; if key(\"ArrowRight\") { x = x + 2.5 }; if key(\"ArrowUp\") { y = y - 2.5 }; if key(\"ArrowDown\") { y = y + 2.5 }; if x < 8.0 { x = 8.0 }; if x > 376.0 { x = 376.0 }; if y < 8.0 { y = 8.0 }; if y > 208.0 { y = 208.0 }; player.pos = xy(x, y); marker.pos = xy(mouse_x(), mouse_y()); if cd > 0 { cd = cd - 1 }; if key(\"Space\") { if cd <= 0 { if bi >= len(bullets) { bi = 0 }; bh = bullets[bi]; bi = bi + 1; cd = 10; node(bh).pos = xy(x, y) } } }" },
                children: [],
            ),
            // 裁判：两个 for_each（弹×敌 嵌套 + 敌×玩家）—— v2 展开坍缩。
            Node(
                name: "referee",
                kind: "Script",
                props: { "source": "init { hp = 3; score = 0; kills = 0 }\non \"tick\" { for_each(children(node(\"bullets\"))) { bh = it; if node(bh).pos.x > -50.0 { for_each(children(node(\"enemies\"))) { dx = node(bh).pos.x - it.pos.x; dy = node(bh).pos.y - it.pos.y; if dx * dx + dy * dy < 121.0 { node(bh).pos = xy(-100.0, -100.0); rx = player.pos.x + 80.0 - score * 5.0; if rx < 40.0 { rx = 40.0 }; if rx > 340.0 { rx = 340.0 }; ry = player.pos.y - 60.0; if ry < 12.0 { ry = 12.0 }; if ry > 196.0 { ry = 196.0 }; it.pos = xy(rx, ry); score = score + 1; kills = kills + 1; if kills % 3 == 0 { heart.pos = xy(player.pos.x, player.pos.y - 24.0) } } } } }; for_each(children(node(\"enemies\"))) { dx = player.pos.x - it.pos.x; dy = player.pos.y - it.pos.y; if dx * dx + dy * dy < 144.0 { hp = hp - 1; it.pos = xy(376.0, 12.0) } }; if hp < 3 { dx = player.pos.x - heart.pos.x; dy = player.pos.y - heart.pos.y; if dx * dx + dy * dy < 144.0 { hp = hp + 1; if hp > 3 { hp = 3 }; heart.pos = xy(-100.0, -100.0) } }; if score >= 8 { door.visible = true }; dx = player.pos.x - door.pos.x; dy = player.pos.y - door.pos.y; over = 0; if score >= 8 { if dx * dx + dy * dy < 256.0 { over = 1; hud.text = \"WIN\"; emit \"over\" 0 } }; if hp <= 0 { over = 1; hud.text = \"LOSE\"; emit \"over\" 0 }; if over == 0 { hud.text = \"HP \" + num_to_str(hp) + \"  SCORE \" + num_to_str(score) } }" },
                children: [],
            ),
        ],
    ),
)
